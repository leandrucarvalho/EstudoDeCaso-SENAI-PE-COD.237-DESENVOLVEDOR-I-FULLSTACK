# Portas publicadas no host
API_PORT=3000
WEB_PORT=5173

# Origem do frontend aceita pela API (CORS) e URL da API usada pelo navegador
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1